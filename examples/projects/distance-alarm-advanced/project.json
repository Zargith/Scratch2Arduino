  "userCode": {
    "language": "cpp",
    "code": "// Mon code (C++) : le capteur se trompe parfois ; on fait la moyenne des dernières mesures.\nfloat memoire = 100;  // la distance moyenne, en cm\n\n// Reçoit une mesure, donne la moyenne (les mesures impossibles sont ignorées).\nfloat moyenne(float mesure) {\n  if (mesure > 2 && mesure < 400) {\n    memoire = memoire * 0.7 + mesure * 0.3;\n  }\n  return memoire;\n}\n\n// Plus l'obstacle est proche, plus la pause entre deux bips est courte (en secondes).\nfloat pauseEntreBips(float distance) {\n  return constrain(distance / 100, 0.03, 0.2);\n}\n"
  }
}
