{
  "format": "scratch2arduino-project",
  "formatVersion": 1,
  "name": "Tous les blocs",
  "board": "uno",
  "variables": [
    { "id": "score", "name": "score", "initialValue": 0 },
    { "id": "lum", "name": "luminosité", "initialValue": 0 }
  ],
  "scripts": [
    {
      "x": 40,
      "y": 40,
      "blocks": [
        { "id": "start", "type": "events_when_program_starts" },
        { "id": "set", "type": "variables_set", "fields": { "VARIABLE": "score" }, "inputs": { "VALUE": { "value": "0" } } },
        { "id": "hello", "type": "serial_print", "inputs": { "VALUE": { "value": "Bonjour \"Arduino\" !" } } },
        { "id": "mode", "type": "pins_set_mode", "fields": { "PIN": "2", "MODE": "INPUT_PULLUP" } },
        {
          "id": "repeat",
          "type": "control_repeat",
          "inputs": { "TIMES": { "value": "3" } },
          "statements": {
            "SUBSTACK": [
              { "id": "dw1", "type": "pins_digital_write", "fields": { "PIN": "7", "STATE": "HIGH" } },
              { "id": "w1", "type": "control_wait", "inputs": { "SECONDS": { "value": "0,2" } } },
              { "id": "dw2", "type": "pins_digital_write", "fields": { "PIN": "7", "STATE": "LOW" } },
              { "id": "change", "type": "variables_change", "fields": { "VARIABLE": "score" }, "inputs": { "VALUE": { "value": "1" } } }
            ]
          }
        },
        {
          "id": "until",
          "type": "control_wait_until",
          "inputs": { "CONDITION": { "block": { "id": "read2", "type": "pins_digital_read", "fields": { "PIN": "2", "STATE": "LOW" } } } }
        },
        {
          "id": "forever",
          "type": "control_forever",
          "statements": {
            "SUBSTACK": [
              {
                "id": "setlum",
                "type": "variables_set",
                "fields": { "VARIABLE": "lum" },
                "inputs": {
                  "VALUE": {
                    "value": "0",
                    "block": {
                      "id": "map",
                      "type": "operators_map",
                      "inputs": {
                        "VALUE": { "value": "0", "block": { "id": "ar", "type": "pins_analog_read", "fields": { "PIN": "A0" } } },
                        "FROM_LOW": { "value": "0" },
                        "FROM_HIGH": { "value": "1023" },
                        "TO_LOW": { "value": "0" },
                        "TO_HIGH": { "value": "255" }
                      }
                    }
                  }
                }
              },
              {
                "id": "print",
                "type": "serial_print",
                "inputs": { "VALUE": { "value": "", "block": { "id": "getlum2", "type": "variables_get", "fields": { "VARIABLE": "lum" } } } }
              },
              {
                "id": "aw",
                "type": "pins_analog_write",
                "fields": { "PIN": "9" },
                "inputs": { "VALUE": { "value": "0", "block": { "id": "getlum", "type": "variables_get", "fields": { "VARIABLE": "lum" } } } }
              },
              {
                "id": "ifelse",
                "type": "control_if_else",
                "inputs": {
                  "CONDITION": {
                    "block": {
                      "id": "and",
                      "type": "operators_and",
                      "inputs": {
                        "OPERAND1": { "block": { "id": "gt", "type": "operators_gt", "inputs": { "NUM1": { "block": { "id": "g1", "type": "variables_get", "fields": { "VARIABLE": "lum" } } }, "NUM2": { "value": "100" } } } },
                        "OPERAND2": {
                          "block": {
                            "id": "or",
                            "type": "operators_or",
                            "inputs": {
                              "OPERAND1": { "block": { "id": "lt", "type": "operators_lt", "inputs": { "NUM1": { "block": { "id": "g2", "type": "variables_get", "fields": { "VARIABLE": "score" } } }, "NUM2": { "value": "10" } } } },
                              "OPERAND2": { "block": { "id": "not", "type": "operators_not", "inputs": { "OPERAND": { "block": { "id": "eq", "type": "operators_equals", "inputs": { "NUM1": { "value": "1" }, "NUM2": { "value": "2" } } } } } } }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "statements": {
                  "SUBSTACK": [ { "id": "ledon", "type": "pins_builtin_led", "fields": { "STATE": "ON" } } ],
                  "SUBSTACK2": [ { "id": "ledoff", "type": "pins_builtin_led", "fields": { "STATE": "OFF" } } ]
                }
              },
              {
                "id": "if",
                "type": "control_if",
                "inputs": { "CONDITION": { "block": { "id": "r2", "type": "pins_digital_read", "fields": { "PIN": "2" } } } },
                "statements": {
                  "SUBSTACK": [
                    {
                      "id": "w2",
                      "type": "control_wait",
                      "inputs": {
                        "SECONDS": {
                          "value": "0",
                          "block": {
                            "id": "div",
                            "type": "operators_divide",
                            "inputs": {
                              "NUM1": { "block": { "id": "rnd", "type": "operators_random", "inputs": { "FROM": { "value": "1" }, "TO": { "value": "10" } } } },
                              "NUM2": { "block": { "id": "mul", "type": "operators_multiply", "inputs": { "NUM1": { "block": { "id": "sub", "type": "operators_subtract", "inputs": { "NUM1": { "value": "12" }, "NUM2": { "value": "2" } } } }, "NUM2": { "block": { "id": "add", "type": "operators_add", "inputs": { "NUM1": { "value": "0.5" }, "NUM2": { "value": "0.5" } } } } } } }
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
      "x": 400,
      "y": 40,
      "blocks": [
        { "id": "start2", "type": "events_when_program_starts" },
        { "id": "inner", "type": "control_forever", "statements": { "SUBSTACK": [ { "id": "w3", "type": "control_wait", "inputs": { "SECONDS": { "value": "1" } } } ] } }
      ]
    }
  ]
}
