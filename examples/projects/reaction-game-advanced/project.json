  "userCode": {
    "language": "cpp",
    "code": "// Mon code (C++) : le record est gardé dans la mémoire EEPROM de la carte, même débranchée.\n#include <EEPROM.h>\n\n// Le meilleur score enregistré (0 la première fois : une EEPROM neuve contient 255).\nint record() {\n  int meilleur = EEPROM.read(0);\n  if (meilleur == 255) {\n    return 0;\n  }\n  return meilleur;\n}\n\n// Garde le score s'il bat le record.\nvoid nouveauRecord(int score) {\n  if (score > record() && score < 255) {\n    EEPROM.update(0, score);\n  }\n}\n"
  }
