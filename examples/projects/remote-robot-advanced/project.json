  "userCode": {
    "language": "cpp",
    "code": "// Mon code (C++) : une seule fonction pilote les deux roues.\n// Vitesse de -100 (en arrière, à fond) à 100 (en avant, à fond) ; 0 arrête la roue.\n\n// Une roue du pont en H L298N : broche de vitesse (EN) et broches de sens (IN1, IN2).\nvoid roue(int en, int in1, int in2, int vitesse) {\n  pinMode(en, OUTPUT);\n  pinMode(in1, OUTPUT);\n  pinMode(in2, OUTPUT);\n  digitalWrite(in1, vitesse > 0 ? HIGH : LOW);\n  digitalWrite(in2, vitesse < 0 ? HIGH : LOW);\n  analogWrite(en, constrain(abs(vitesse), 0, 100) * 255 / 100);\n}\n\n// Roue gauche : ENA 25, IN1 26, IN2 27. Roue droite : ENB 33, IN3 18, IN4 19.\nvoid rouler(int gauche, int droite) {\n  roue(25, 26, 27, gauche);\n  roue(33, 18, 19, droite);\n}\n"
  }
