# s2a_install_desktop_entry(<target> NAME <name> COMMENT_SUFFIX <text>)
# Installs a freedesktop .desktop launcher for <target> (Linux only).
function(s2a_install_desktop_entry target)
    if(NOT UNIX OR APPLE)
        return()
    endif()
    cmake_parse_arguments(ARG "" "NAME;VARIANT" "" ${ARGN})
    set(S2A_DESKTOP_NAME "${ARG_NAME}")
    set(S2A_DESKTOP_VARIANT "${ARG_VARIANT}")
    set(S2A_DESKTOP_EXEC "${CMAKE_INSTALL_FULL_BINDIR}/${target}")
    set(output "${CMAKE_CURRENT_BINARY_DIR}/${target}.desktop")
    configure_file("${PROJECT_SOURCE_DIR}/resources/linux/scratch2arduino.desktop.in" "${output}" @ONLY)
    install(FILES "${output}" DESTINATION ${CMAKE_INSTALL_DATADIR}/applications)
endfunction()
