# Removes every file listed in install_manifest.txt (written by `cmake --install`).
set(manifest "@CMAKE_BINARY_DIR@/install_manifest.txt")
if(NOT EXISTS "${manifest}")
    message(FATAL_ERROR "Nothing to uninstall: ${manifest} not found (run the install step first).")
endif()

file(STRINGS "${manifest}" installed_files)
foreach(installed_file IN LISTS installed_files)
    set(path "$ENV{DESTDIR}${installed_file}")
    if(IS_SYMLINK "${path}" OR EXISTS "${path}")
        message(STATUS "Removing ${path}")
        file(REMOVE "${path}")
    else()
        message(STATUS "Already removed: ${path}")
    endif()
endforeach()
file(REMOVE "${manifest}")
