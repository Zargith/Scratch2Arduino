{
  "$schema": "../schema/catalog.schema.json",
  "category": {
    "id": "mycode",
    "colour": "#0FBD8C",
    "name": { "fr": "Mon code", "en": "My code" },
    "order": 65
  },
  "blocks": [
    {
      "type": "mycode_call",
      "shape": "statement",
      "message": { "fr": "%1 %2 %3 %4 %5", "en": "%1 %2 %3 %4 %5" },
      "tooltip": {
        "fr": "Exécute une fonction écrite dans « Mon code », avec les nombres donnés.",
        "en": "Runs a function written in \"My code\", with the numbers given."
      },
      "args": [
        { "name": "NAME", "kind": "usercode" },
        { "name": "ARG1", "kind": "number", "default": 0 },
        { "name": "ARG2", "kind": "number", "default": 0 },
        { "name": "ARG3", "kind": "number", "default": 0 },
        { "name": "ARG4", "kind": "number", "default": 0 }
      ]
    },
    {
      "type": "mycode_value",
      "shape": "reporter",
      "message": { "fr": "%1 %2 %3 %4 %5", "en": "%1 %2 %3 %4 %5" },
      "tooltip": {
        "fr": "Le résultat d'une fonction écrite dans « Mon code ».",
        "en": "The result of a function written in \"My code\"."
      },
      "args": [
        { "name": "NAME", "kind": "usercode" },
        { "name": "ARG1", "kind": "number", "default": 0 },
        { "name": "ARG2", "kind": "number", "default": 0 },
        { "name": "ARG3", "kind": "number", "default": 0 },
        { "name": "ARG4", "kind": "number", "default": 0 }
      ]
    },
    {
      "type": "mycode_get",
      "shape": "reporter",
      "message": { "fr": "%1", "en": "%1" },
      "tooltip": {
        "fr": "La valeur d'une variable de « Mon code ».",
        "en": "The value of a variable of \"My code\"."
      },
      "args": [{ "name": "NAME", "kind": "usercode" }]
    },
    {
      "type": "mycode_set",
      "shape": "statement",
      "message": { "fr": "mettre %1 à %2", "en": "set %1 to %2" },
      "tooltip": {
        "fr": "Donne une nouvelle valeur à une variable de « Mon code ».",
        "en": "Gives a new value to a variable of \"My code\"."
      },
      "args": [
        { "name": "NAME", "kind": "usercode" },
        { "name": "VALUE", "kind": "number", "default": 0 }
      ]
    }
  ]
}
