      "type": "lights_rgb_mix",
      "shape": "statement",
      "component": "rgb_led",
      "message": {
        "fr": "mettre la LED RGB (R %1, V %2, B %3) à rouge %4 vert %5 bleu %6",
        "en": "set the RGB LED (R %1, G %2, B %3) to red %4 green %5 blue %6"
      },
      "tooltip": {
        "fr": "Mélange les trois couleurs de la LED RGB : chaque valeur va de 0 (éteint) à 255 (à fond). Par exemple rouge 255, vert 128, bleu 0 donne de l'orange.",
        "en": "Mixes the three colours of the RGB LED: each value goes from 0 (off) to 255 (full). For example red 255, green 128, blue 0 makes orange."
      },
      "args": [
        {
          "name": "RED_PIN",
          "kind": "pin",
          "capability": "pwm",
          "default": "9"
