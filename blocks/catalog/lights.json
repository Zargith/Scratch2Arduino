      "type": "lights_rgb_color",
      "shape": "statement",
      "component": "rgb_led",
      "message": {
        "fr": "mettre la LED RGB (R %1, V %2, B %3) en %4",
        "en": "set the RGB LED (R %1, G %2, B %3) to %4"
      },
      "tooltip": {
        "fr": "Allume une LED RGB d'une couleur. Branche ses pattes rouge (R), verte (V) et bleue (B) sur trois broches PWM (~), chacune avec une résistance, et la patte la plus longue sur GND.",
        "en": "Lights an RGB LED in a colour. Wire its red (R), green (G) and blue (B) legs to three PWM pins (~), each through a resistor, and the longest leg to GND."
      },
      "args": [
        {
          "name": "RED_PIN",
          "kind": "pin",
          "capability": "pwm",
          "default": "9"
        },
