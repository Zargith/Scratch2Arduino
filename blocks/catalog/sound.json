  "blocks": [
    {
      "type": "sound_play_tone",
      "shape": "statement",
      "component": "buzzer",
      "message": {
        "fr": "jouer %2 Hz pendant %3 secondes sur le buzzer de la broche %1",
        "en": "play %2 Hz for %3 seconds on the buzzer of pin %1"
      },
      "tooltip": {
        "fr": "Fait sonner un buzzer, puis attend la fin du son avant de passer au bloc suivant. Plus le nombre de Hz est grand, plus le son est aigu (440 Hz est le la de la musique). Il faut un buzzer passif (sans autocollant, on voit le circuit dessous) : un buzzer actif grésille au lieu de jouer la note.",
        "en": "Plays a sound on a buzzer and waits until it ends before the next block. The more Hz, the higher the sound (440 Hz is the musical A). It needs a passive buzzer (no sticker, the circuit board shows underneath): an active buzzer crackles instead of playing the note."
      },
      "args": [
        {
          "name": "PIN",
          "kind": "pin",
          "capability": "digital",
          "default": "8"
        },
        {
          "name": "FREQUENCY",
          "kind": "number",
          "default": 440,
          "min": 31,
          "max": 20000
        },
        {
          "name": "SECONDS",
          "kind": "number",
          "default": 0.5,
          "min": 0
        }
      ]
    },
    {
      "type": "sound_start_tone",
      "shape": "statement",
      "component": "buzzer",
      "message": {
        "fr": "faire sonner le buzzer de la broche %1 à %2 Hz",
        "en": "start the buzzer of pin %1 at %2 Hz"
      },
      "tooltip": {
        "fr": "Le buzzer sonne sans s'arrêter, et le programme continue tout de suite. Utilise \"arrêter le buzzer\" pour le faire taire. Un seul buzzer peut sonner à la fois. Il faut un buzzer passif (sans autocollant, on voit le circuit dessous) : un buzzer actif grésille au lieu de jouer la note.",
        "en": "The buzzer keeps sounding and the program goes on at once. Use \"stop the buzzer\" to silence it. Only one buzzer can sound at a time. It needs a passive buzzer (no sticker, the circuit board shows underneath): an active buzzer crackles instead of playing the note."
      },
      "args": [
        {
          "name": "PIN",
          "kind": "pin",
          "capability": "digital",
          "default": "8"
        },
        {
          "name": "FREQUENCY",
          "kind": "number",
          "default": 440,
          "min": 31,
          "max": 20000
        }
      ]
    },
    {
      "type": "sound_stop",
      "shape": "statement",
      "component": "buzzer",
      "message": {
        "fr": "arrêter le buzzer de la broche %1",
        "en": "stop the buzzer of pin %1"
      },
      "tooltip": {
        "fr": "Fait taire le buzzer.",
        "en": "Silences the buzzer."
      },
      "args": [
        {
          "name": "PIN",
          "kind": "pin",
          "capability": "digital",
          "default": "8"
        }
      ]
    },
    {
