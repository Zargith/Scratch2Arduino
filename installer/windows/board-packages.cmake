# Writes the optional board packages of resources/board-packages.json as Inno Setup snippets,
# included by scratch2arduino.iss (one task per package, with its size, under "More boards"):
#   cmake -P installer/windows/board-packages.cmake
# Output, next to this script (not in git): board-tasks.isi, board-messages.isi, board-code.isi.
# Without them, the installer is built without the board tasks.
cmake_minimum_required(VERSION 3.25)

get_filename_component(here "${CMAKE_CURRENT_LIST_DIR}" ABSOLUTE)
get_filename_component(root "${here}/../.." ABSOLUTE)
file(READ "${root}/resources/board-packages.json" json)

# Sizes as the application writes them (decimal units): "1,9 Go" / "1.9 GB", "125 Mo" / "125 MB".
function(format_size bytes language out)
    if(bytes GREATER_EQUAL 1000000000)
        set(unit 1000000000)
        set(name_fr "Go")
        set(name_en "GB")
    else()
        set(unit 1000000)
        set(name_fr "Mo")
        set(name_en "MB")
    endif()
    math(EXPR tenths "(${bytes} * 10 + ${unit} / 2) / ${unit}")
    math(EXPR whole "${tenths} / 10")
    math(EXPR decimal "${tenths} % 10")
    set(text "${whole}")
    if(tenths LESS 100 AND NOT decimal EQUAL 0)
        if(language STREQUAL "fr")
            set(text "${whole},${decimal}")
        else()
            set(text "${whole}.${decimal}")
        endif()
    endif()
    set(${out} "${text} ${name_${language}}" PARENT_SCOPE)
endfunction()

# Board names, by platform ("ESP32 (DevKit)").
file(GLOB board_files "${root}/resources/boards/*.json")
list(SORT board_files)
foreach(board_file IN LISTS board_files)
    file(READ "${board_file}" board_json)
    string(JSON platform GET "${board_json}" platform)
    string(JSON name GET "${board_json}" name)
    string(MAKE_C_IDENTIFIER "${platform}" key)
    list(APPEND boards_${key} "${name}")
endforeach()

set(tasks "")
set(messages "")
set(names_case "")
set(ids_case "")
set(dirs_case "")
set(count 0)
string(JSON package_count LENGTH "${json}" packages)
math(EXPR last "${package_count} - 1")
foreach(i RANGE ${last})
    string(JSON shipped ERROR_VARIABLE no_shipped GET "${json}" packages ${i} shipped)
    if(NOT no_shipped AND shipped)
        continue() # comes with the application
    endif()
    string(JSON id GET "${json}" packages ${i} id)
    string(JSON platform GET "${json}" packages ${i} platform)
    string(JSON name_fr GET "${json}" packages ${i} name fr)
    string(JSON name_en GET "${json}" packages ${i} name en)
    string(JSON download GET "${json}" packages ${i} estimate download)
    string(JSON disk GET "${json}" packages ${i} estimate disk)
    string(MAKE_C_IDENTIFIER "${id}" task)
    set(task "board_${task}")
    string(MAKE_C_IDENTIFIER "${platform}" key)
    list(JOIN boards_${key} ", " board_names)
    string(REPLACE ":" ";" parts "${platform}")
    list(GET parts 0 vendor)
    list(GET parts 1 arch)
    format_size(${download} fr download_fr)
    format_size(${disk} fr disk_fr)
    format_size(${download} en download_en)
    format_size(${disk} en disk_en)

    string(APPEND tasks "Name: \"${task}\"; Description: \"{cm:${task}}\"; GroupDescription: \"{cm:BoardPackages}\"; Flags: unchecked\n")
    string(APPEND messages "french.${task}=${name_fr} (${board_names}) : environ ${download_fr} à télécharger, ${disk_fr} sur le disque\n")
    string(APPEND messages "english.${task}=${name_en} (${board_names}): about ${download_en} to download, ${disk_en} on the disk\n")
    string(APPEND names_case "    ${count}: Result := '${task}';\n")
    string(APPEND ids_case "    ${count}: Result := '${id}';\n")
    string(APPEND dirs_case "    ${count}: Result := '${vendor}\\hardware\\${arch}';\n")
    math(EXPR count "${count} + 1")
endforeach()

set(header "; Generated by installer/windows/board-packages.cmake from resources/board-packages.json: do not edit.\n")
file(WRITE "${here}/board-tasks.isi" "${header}${tasks}")
# UTF-8 with a BOM, like scratch2arduino.iss: Inno Setup then reads the accents right.
string(ASCII 239 187 191 bom)
file(WRITE "${here}/board-messages.isi" "${bom}${header}${messages}")
file(WRITE "${here}/board-code.isi" "// Generated by installer/windows/board-packages.cmake from resources/board-packages.json: do not edit.

// Number of optional board packages offered by the installer.
function BoardTaskCount(): Integer;
begin
  Result := ${count};
end;

// Name of the task of package I (0-based).
function BoardTaskName(I: Integer): String;
begin
  case I of
${names_case}  else Result := '';
  end;
end;

// Id of package I for s2a-cli board install.
function BoardPackageId(I: Integer): String;
begin
  case I of
${ids_case}  else Result := '';
  end;
end;

// Folder of package I under <arduino data>\\packages: it holds a version folder once installed.
function BoardPackageDir(I: Integer): String;
begin
  case I of
${dirs_case}  else Result := '';
  end;
end;
")
message(STATUS "Board packages for the installer: ${count}")
